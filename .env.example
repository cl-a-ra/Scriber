# Local setup: copy this file to .env, then run npm.cmd install
# and npm.cmd run dev on Windows (npm install / npm run dev elsewhere).
# GEMINI_API_KEY: Optional locally; leave empty to use curated quotes.
# Set a real key here to enable Gemini AI calls. Never commit your .env.
# AI Studio can inject this at runtime from its Secrets panel.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
