{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Owner-only profile with an optimized photo, bio and account preferences; creation time is preserved on updates",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "bio": { "type": "string", "maxLength": 280 },
        "photoData": { "type": ["string", "null"], "maxLength": 200000 },
        "useAccountPhoto": { "type": "boolean" },
        "preferences": { "$ref": "#/entities/UserPreferences" },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["uid", "email", "displayName", "bio", "photoData", "useAccountPhoto", "preferences", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "type": "object",
      "properties": {
        "themeColor": { "type": "string" },
        "fontChoice": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "dailyNotificationEnabled": { "type": "boolean" },
        "notificationTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "required": ["themeColor", "fontChoice", "darkMode", "dailyNotificationEnabled", "notificationTime"],
      "additionalProperties": false
    },
    "ManifestationDraft": {
      "type": "object",
      "properties": {
        "intention": { "type": "string", "maxLength": 1000 },
        "feeling": { "type": "string", "maxLength": 1000 },
        "action": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 100000 },
        "focus": { "type": "string" },
        "method": { "type": "string", "enum": ["freewrite", "future-self", "gratitude", "369"] },
        "background": { "type": "string" },
        "font": { "type": "string" }
      },
      "required": ["intention", "feeling", "action", "text", "focus", "method", "background", "font"]
    },
    "ManifestationEntry": {
      "allOf": [
        { "$ref": "#/entities/ManifestationDraft" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "createdAt": { "type": "string" },
            "fulfilled": { "type": "boolean" }
          },
          "required": ["id", "createdAt", "fulfilled"]
        }
      ]
    },
    "Quote": {
      "title": "Quote",
      "description": "Quote about any topic with typography and artwork; generated quotes are private until explicitly shared",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "visualStyle": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "backgroundStyle": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "likesCount": {
          "type": "number"
        },
        "sixHourCycle": {
          "type": "string"
        },
        "highlightWords": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
        "vibeBadge": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "authorName", "text", "category", "visualStyle", "fontFamily", "backgroundStyle", "accentColor", "likesCount", "createdAt"]
    },
    "QuoteFeedback": {
      "title": "QuoteFeedback",
      "description": "Community feedback, reflections and encouragement on quotes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "quoteId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "quoteId", "userId", "userName", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user preferences and profiles"
    },
    "/users/{userId}/saved_quotes/{quoteId}": {
      "schema": "Quote",
      "description": "User's personal saved collection of favorite quotes and inspiration"
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Owner-only generated quote library"
    },
    "/users/{userId}/manifestation_drafts/current": {
      "schema": "ManifestationDraft",
      "description": "Owner-only working draft, queued locally while offline"
    },
    "/users/{userId}/manifestations/{entryId}": {
      "schema": "ManifestationEntry",
      "description": "Owner-only saved manifestations and fulfillment progress"
    },
    "/public_quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Public inspiration and community quotes; personal AI generation is not automatically published here"
    },
    "/public_quotes/{quoteId}/feedbacks/{feedbackId}": {
      "schema": "QuoteFeedback",
      "description": "Community feedback and appreciation notes on public quotes"
    }
  }
}
